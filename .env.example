# Copy to .env and fill in. NEVER commit .env.
# If HINDSIGHT_BASE_URL is empty, the app falls back to the in-memory FAKE client (local dev only).
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-learning-agent

# Optional: only used to polish the "why the plan changed" text. Rule-based fallback if empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
